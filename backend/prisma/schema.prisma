generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  ADVERTISER
  PUBLISHER
}

// Only meaningful when role = ADMIN - narrows an admin login to one side of
// the marketplace. MASTER sees/does everything (equivalent to today's
// unscoped ADMIN); PUBLISHER and ADVERTISER are restricted to their side's
// endpoints by AdminScopeGuard (see auth/guards/admin-scope). Left null for
// non-admin users.
enum AdminScope {
  MASTER
  PUBLISHER
  ADVERTISER
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

// POPUNDER and INTERSTITIAL are reused by the extended format catalog below
// (as "Popunder" and "Full Screen Interstitial" respectively - see
// AD_FORMAT_CATALOG in web/lib/ad-formats.ts) instead of adding duplicate
// values. SOCIAL_BAR / NATIVE_BANNER / IN_PAGE_PUSH predate that catalog and
// are kept only for backward compatibility with existing campaigns.
enum CampaignAdFormat {
  POPUNDER
  SOCIAL_BAR
  NATIVE_BANNER
  IN_PAGE_PUSH
  INTERSTITIAL

  // --- Display Ads ---
  BANNER_728X90
  LEADERBOARD
  MEDIUM_RECTANGLE_300X250
  LARGE_RECTANGLE_336X280
  STICKY_BANNER

  // --- Sidebar Ads ---
  SKYSCRAPER_160X600
  WIDE_SKYSCRAPER_300X600
  STICKY_SIDEBAR
  FLOATING_SIDEBAR

  // --- Native Ads ---
  IN_ARTICLE
  IN_FEED
  RECOMMENDED_CONTENT
  SPONSORED_WIDGET

  // --- Popup & Overlay Ads ---
  POPUP
  EXIT_INTENT_POPUP
  FLOATING_OVERLAY
  WELCOME_SCREEN

  // --- Interstitial Ads ---
  PAGE_TRANSITION_INTERSTITIAL

  // --- Video Ads ---
  PRE_ROLL
  MID_ROLL
  POST_ROLL
  VIDEO_OVERLAY

  // --- Premium Inventory ---
  HOMEPAGE_HERO_BANNER
  NEWSLETTER_SPONSORSHIP
  SPONSORED_BLOG_POST
  SPONSORED_SECTION
  STICKY_BOTTOM_BANNER
  FLOATING_CORNER_AD
}

enum CampaignPricingModel {
  CPM
  CPA
  CPC
}

// Mirrors Adsterra's "Choose a start time" control on campaign creation.
enum CampaignStartMode {
  START_ONCE_VERIFIED
  SCHEDULE
  KEEP_INACTIVE
}

enum AdZoneStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum SiteStatus {
  ACTIVE
  INACTIVE
}

enum SiteVerificationMethod {
  // Publisher pasted the token into their own ads.txt (self-serve, Step 1
  // of the dashboard flow).
  ADS_TXT
  // Domain proved itself the first time a real ad request came in from it -
  // see AdEngineController.serve / SiteAutoVerificationService. Trusted
  // because it's derived from the request's Referer/Origin HTTP header,
  // which client JS cannot forge to a different domain, not from any
  // client-suppliable query param.
  AD_SNIPPET
}

enum TransactionType {
  DEPOSIT
  CAMPAIGN_RESERVATION
  AD_SPEND
  REFUND
  PUBLISHER_EARNING
  PAYOUT_REQUEST
  PAYOUT_COMPLETED
  PAYOUT_FAILED
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
}

// id is NOT auto-generated here - it's always set explicitly to the
// corresponding Supabase auth.users.id (see SupabaseService /
// AuthService.register), so this table and Supabase's user store share one
// id space. Credentials (password, email verification) live in Supabase
// Auth exclusively; this table only holds app-level profile/role data.
model User {
  id          String   @id
  name        String
  email       String   @unique
  // E.164 format (e.g. "+15551234567"). Optional - only set once a user
  // verifies a phone number via OTP (see AuthService.verifyPhoneOtp).
  // Verification itself is delegated to Supabase Auth's phone/SMS provider,
  // same as email/password lives in Supabase rather than this table.
  phone       String?  @unique
  role        UserRole
  // Only set (and only meaningful) when role = ADMIN - see AdminScope.
  adminScope  AdminScope?
  balance_usd Decimal  @default(0) @db.Decimal(12, 2)

  campaigns          Campaign[]
  adZones            AdZone[]
  publisherSites     PublisherSite[]
  wallet             Wallet?
  paymentOrders      PaymentOrder[]
  beneficiaryAccount BeneficiaryAccount?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

// One wallet per user. `balance_usd` on User remains the single
// spendable/withdrawable "available" balance (it's the row the existing
// WalletManager.deduct/credit already lock and mutate atomically) - this
// table only tracks the money that ISN'T freely available yet (reserved for
// campaigns, pending publisher earnings) plus lifetime counters for the
// summary endpoints. Splitting it this way means we never have two sources
// of truth for the number that actually gates spending.
model Wallet {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  reservedBalance Decimal @default(0) @db.Decimal(12, 2)
  pendingEarnings Decimal @default(0) @db.Decimal(12, 2)
  totalDeposited  Decimal @default(0) @db.Decimal(12, 2)
  totalSpent      Decimal @default(0) @db.Decimal(12, 2)
  totalEarned     Decimal @default(0) @db.Decimal(12, 2)
  totalWithdrawn  Decimal @default(0) @db.Decimal(12, 2)
  currency        String  @default("USD")

  transactions WalletTransaction[]
  payouts      Payout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Immutable, append-only ledger. Every financial event on a wallet writes
// exactly one row here and rows are never updated - state changes (e.g. a
// payout moving from REQUESTED to COMPLETED) get their own new row/type
// instead of mutating history.
model WalletTransaction {
  id       String @id @default(uuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId   String

  type        TransactionType
  amount      Decimal           @db.Decimal(12, 2)
  currency    String            @default("USD")
  status      TransactionStatus @default(COMPLETED)
  referenceId String?
  description String?
  metadata    Json?

  createdAt DateTime @default(now())

  // Prevents the same source event (e.g. one ad-spend click, one payout)
  // from ever being ledgered twice for a given wallet+type.
  @@unique([walletId, type, referenceId])
  @@index([walletId])
  @@index([userId])
  @@index([type])
}

model Payout {
  id       String @id @default(uuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId   String

  amount        Decimal      @db.Decimal(12, 2)
  currency      String       @default("USD")
  status        PayoutStatus @default(REQUESTED)
  provider      String?
  providerRef   String?
  failureReason String?
  metadata      Json?

  requestedAt DateTime  @default(now())
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletId])
  @@index([userId])
  @@index([status])
}

model PublisherSite {
  id          String @id @default(uuid())
  publisherId String
  publisher   User   @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  domain             String
  // Only populated for ADS_TXT verifications - AD_SNIPPET sites are proved
  // by an actual ad request's Referer, not by fetching an ads.txt file.
  adsTxtUrl          String?
  expectedText       String?
  verificationMethod SiteVerificationMethod @default(ADS_TXT)
  verified           Boolean                @default(false)
  verifiedAt         DateTime?
  status             SiteStatus             @default(ACTIVE)
  // Free-text content category picked in the "Add new Website" dialog (e.g.
  // "Entertainment", "Technology") - purely descriptive, not enforced
  // against a fixed enum since the publisher-facing category list lives in
  // the frontend (web/app/publisher/websites/site-meta.ts) and can grow
  // without a migration.
  category           String?
  // Publisher opted this site in to adult ad demand (typically higher CPM).
  // Ad serving does not yet branch on this - it's recorded for the
  // publisher's own reference and for future targeting.
  adultAds           Boolean                @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adZones AdZone[]

  @@unique([publisherId, domain])
  @@index([publisherId])
  @@index([verified])
  @@index([status])
}

model Campaign {
  id String @id @default(uuid())

  advertiserId String
  advertiser   User   @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  campaignName String

  totalBudget Decimal @db.Decimal(12, 2)
  dailyBudget Decimal @db.Decimal(12, 2)
  maxCpc      Decimal @db.Decimal(10, 2)
  // Bid per 1000 impressions. Null/unset = this campaign is NOT CPM-billed -
  // it stays on the existing pay-per-click (maxCpc) model. Deliberately NOT
  // gated on `pricingModel` below: that column already defaults to CPM for
  // every campaign (including ones created before this field existed) while
  // actual billing has only ever been CPC, so trusting it here would silently
  // stop billing every existing live campaign the moment CPM billing shipped.
  // maxCpm being set is the real, explicit opt-in signal.
  maxCpm      Decimal? @db.Decimal(10, 2)
  // Bid per verified conversion (see AdClick/ConversionTrackingService).
  // Same opt-in rule as maxCpm above, and NOT mutually exclusive with it -
  // a campaign with maxCpa set is never charged for a click (see
  // AdEngineController.isCpaCampaign), only for a conversion postback
  // confirmed against a real prior click, but it still competes in the
  // ad-serving auction on maxCpc like any CPC campaign - there's no
  // reliable way to convert "$ per conversion" into a comparable per-click
  // bid without a predicted conversion rate, which isn't tracked.
  maxCpa      Decimal? @db.Decimal(10, 2)

  // Funds held out of the advertiser's available balance for this campaign
  // (via WalletManager.reserveCampaignBudget) and the portion of that hold
  // already converted into ledgered ad spend.
  reservedAmount Decimal @default(0) @db.Decimal(12, 2)
  spentAmount    Decimal @default(0) @db.Decimal(12, 2)

  targetCountries String[]
  targetDevices   String[]

  // Adsterra-style campaign setup fields. All additive/nullable-or-defaulted
  // so existing rows and the ad-serving path (AdEngineController) are
  // unaffected - none of these are read there yet.
  adFormat        CampaignAdFormat?
  pricingModel    CampaignPricingModel @default(CPM)
  // Per-country bid override: { "US": 1.2, "IN": 0.4, ... }. Optional -
  // falls back to maxCpc when a country has no override.
  countryPricing  Json?
  // Region/city include-exclude rules: [{ country, region?, city?, include }]
  locations       Json?
  budgetUnlimited Boolean              @default(false)
  startMode       CampaignStartMode    @default(START_ONCE_VERIFIED)
  // Only meaningful when startMode is SCHEDULE.
  scheduledAt     DateTime?

  // Per-campaign override for AdEngine's per-visitor frequency cap: at most
  // this many impressions of THIS campaign to the same visitor within
  // frequencyCapWindowSeconds. Null means "use the platform default" (see
  // VisitorFrequencyCapService) rather than "uncapped" - there's no way to
  // disable capping per campaign, only to tune it.
  frequencyCapImpressions   Int?
  frequencyCapWindowSeconds Int?

  creativeType   String?
  creativeUrl    String?
  creativeHtml   String?
  // Click-through destination for image creatives - AdEngineController
  // wraps the rendered <img> in an anchor through /api/v1/click when this
  // is set, so clicks get recorded before redirecting. HTML creatives
  // supply their own links inline and ignore this field.
  destinationUrl String?
  notes          String?

  status CampaignStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([advertiserId])
  @@index([status])
  @@index([advertiserId, status])
}

model AdZone {
  id String @id @default(uuid())

  publisherId String
  publisher   User   @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  // Optional - zones created before this field existed, or created from the
  // generic Publisher Portal flow rather than a specific site's "Add ad
  // unit" action, have no site. SetNull (not Cascade) so archiving/deleting
  // a site never takes a zone's stats history with it.
  siteId String?
  site   PublisherSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  zoneName String

  width  Int
  height Int

  layoutType String
  status     AdZoneStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publisherId])
  @@index([status])
  @@index([siteId])
}

model BlacklistedIp {
  id        String @id @default(uuid())
  ipAddress String @unique
  source    String
  reason    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ipAddress])
  @@index([source])
}

// Single-row config table (always id "default") for network-wide knobs an
// admin can tune at runtime without a redeploy. Starts with just the
// platform revenue cut - see PlatformSettingsService.
model PlatformSetting {
  id String @id @default("default")

  // Share of every ad-spend dollar the platform keeps before crediting the
  // rest to the publisher, in basis points (2000 = 20.00%). Basis points
  // (not a float percentage) so this can't drift into unrepresentable
  // values like 0.1 + 0.2 - it's an exact integer 0-10000.
  platformFeeBps Int @default(2000)

  // Admin-editable rate card, keyed by ad format value (see AD_FORMATS in
  // common/ad-formats.ts): { [adFormat]: { cpm, cpa, cpc } } in dollars.
  // Null/missing entries fall back to PlatformSettingsService's
  // DEFAULT_AD_FORMAT_PRICING - see getAdFormatPricing().
  adFormatPricing Json?

  // USD->INR conversion rate used to price a Razorpay top-up order when an
  // advertiser pays in INR (see PaymentsService.createTopupOrder). The USD
  // amount actually credited to the wallet is locked in on PaymentOrder at
  // order-creation time and never recomputed from a later/different rate -
  // this only decides how many rupees Razorpay charges for that fixed USD
  // credit. Null falls back to RazorpayService's env-configured default.
  usdToInrRate Decimal? @db.Decimal(12, 4)

  updatedAt DateTime @updatedAt
}

enum PaymentOrderStatus {
  CREATED
  PAID
  FAILED
}

// One row per advertiser top-up attempt via a payment gateway (currently
// PayPal; the "razorpay" default below is a historical leftover from
// before the PayPal migration - every new row sets `provider` explicitly,
// see PaymentsService.createTopupOrder). Money is only ever credited to the
// wallet once this row transitions CREATED -> PAID (see
// PaymentsService.markPaidAndCredit) - the conditional `status: CREATED`
// guard on that update is what makes crediting exactly-once safe even if
// the client-side confirm call and the PayPal webhook both arrive for the
// same payment.
model PaymentOrder {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider String @default("razorpay")
  // PayPal's order id (was Razorpay's order_... id for older rows). Unique
  // so a given gateway order can only ever back one PaymentOrder row.
  providerOrderId String @unique
  // PayPal's capture id (was Razorpay's pay_... id for older rows), set once
  // the payment actually lands. Unique so the same captured payment can
  // never be used to credit two orders.
  providerPaymentId String? @unique

  // What the advertiser actually paid, in the currency they paid it in.
  // Always "USD" for PayPal orders - PayPal shows non-US buyers a
  // local-currency estimate on its own side, so there's nothing to record
  // here beyond USD. Older Razorpay rows may have "INR" instead.
  payCurrency String
  payAmount   Decimal @db.Decimal(12, 2)

  // USD amount credited to the wallet on success - fixed at order creation,
  // independent of payCurrency.
  creditAmountUsd Decimal @db.Decimal(12, 2)
  // usdToInrRate snapshot used to price an older Razorpay INR order, for
  // reconciliation only (not re-read on confirm). Always null for PayPal
  // orders, which are always priced in USD.
  fxRate Decimal? @db.Decimal(12, 6)

  status        PaymentOrderStatus @default(CREATED)
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

enum BeneficiaryAccountType {
  BANK_ACCOUNT
  VPA
}

// A publisher's payout destination - bank account or UPI VPA. Used by
// RazorpayXPayoutProvider (backend/src/wallet/payout-providers) to create a
// RazorpayX Contact + Fund Account before submitting a real payout; the
// manual provider ignores this entirely. One row per user - re-saving
// replaces the details AND clears the cached RazorpayX ids (see
// BeneficiaryAccountService.upsert) so a stale Fund Account can never keep
// receiving money after a publisher updates their account.
model BeneficiaryAccount {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountType       BeneficiaryAccountType
  accountHolderName String

  // Set when accountType = BANK_ACCOUNT, null otherwise.
  bankAccountNumber String?
  ifscCode          String?

  // Set when accountType = VPA, null otherwise.
  vpa String?

  // RazorpayX identifiers, created lazily on the first payout attempt and
  // reused after that (see RazorpayXPayoutProvider.ensureFundAccount).
  // Both cleared back to null whenever the details above are edited.
  razorpayContactId     String?
  razorpayFundAccountId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per click on a CPA-priced campaign only (see
// AdEngineController.isCpaCampaign) - a CPC/CPM campaign's clicks are never
// persisted here, they're only ever published as ClickEvent stream
// messages. The id IS the "click_id" AdEngineController embeds in the
// click-tracking URL and forwards on to the advertiser's destination page,
// so the advertiser's own postback (GET /api/v1/conversion?clickId=...) has
// something stable to reference. convertedAt/conversionValue get filled in
// exactly once by ConversionTrackingService - see its atomic
// updateMany(... WHERE convertedAt IS NULL) claim, which is what makes a
// replayed/duplicate postback for the same click a no-op instead of a
// double bill.
model AdClick {
  id String @id @default(uuid())

  campaignId String
  zoneId     String

  createdAt       DateTime @default(now())
  convertedAt     DateTime?
  conversionValue Decimal? @db.Decimal(12, 2)

  @@index([campaignId])
  @@index([createdAt])
}
