DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (non-pooled) connection, needed only for `prisma migrate`.
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# From Supabase Project Settings -> API.
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_ANON_KEY="replace-with-anon-public-key"
# Secret - server-side only, bypasses Row Level Security. Never expose to
# the frontend or commit a real value.
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"

NODE_ENV=development
PORT=3000

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Set to "true" for managed Redis providers that require TLS (e.g. Upstash).
# Leave unset/false for a local/docker-compose Redis, which is plain TCP.
REDIS_TLS=

CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

PUBLIC_TAG_URL=http://localhost:3000/assets/publisher_tag.js
# Directory (relative to the backend's cwd at runtime) served under
# /assets - holds publisher_tag.js, the ad tag publishers embed. Defaults
# to "public" (backend/public/), which is self-contained so it survives a
# deploy where only backend/ is built (e.g. Railway root directory).
FRONTEND_DIR=public
# Base URL of the web/ (Next.js) app, used only in the root `/` route's
# links back to the publisher/advertiser/analytics UIs.
WEB_APP_URL=http://localhost:3001
CAMPAIGN_CACHE_SYNC_ENABLED=true
CLICKHOUSE_INGESTION_ENABLED=true
# Path to a GeoLite2-Country.mmdb file. Defaults to the bundled MaxMind test
# fixture (test/fixtures/geoip) so serving works out of the box in dev/CI.
# Get a real, free-tier file at https://www.maxmind.com/en/geolite2/signup
# and point this at it for production-accurate geolocation.
GEOIP_DB_PATH=
VELOCITY_IMPRESSION_LIMIT=2
VELOCITY_IMPRESSION_WINDOW_SECONDS=30
VELOCITY_CLICK_LIMIT=3
VELOCITY_CLICK_WINDOW_SECONDS=60

# Cloudflare Turnstile secret key - from
# https://dash.cloudflare.com/?to=/:account/turnstile. Must match the
# NEXT_PUBLIC_TURNSTILE_SITE_KEY configured on the frontend. Leave unset in
# local dev - login/register skip verification (with a logged warning)
# rather than failing every request.
TURNSTILE_SECRET_KEY=

# --- Forgot password ---
# No extra env var needed here - AuthService.forgotPassword/resetPassword
# call Supabase Auth's own resetPasswordForEmail/updateUser APIs, so the
# reset email is sent by whatever mailer is configured on the Supabase
# project (Project Settings -> Authentication -> SMTP Settings). Supabase's
# built-in mailer works out of the box for dev/testing but is low-volume and
# rate-limited - plug in a real SMTP provider (SendGrid, Postmark, SES,
# etc.) there before relying on this in production.

# --- Phone OTP login/signup ---
# No extra env var needed here either - AuthService.sendPhoneOtp/
# verifyPhoneOtp call Supabase Auth's phone sign-in APIs. Enable phone auth
# and configure an SMS provider (e.g. Twilio: Account SID, Auth Token,
# Message Service SID) under Project Settings -> Authentication -> Phone
# Auth in the Supabase dashboard - not in this file.

# --- Google sign-in ---
# OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials
# (type "Web application"). Used server-side to verify the ID token the
# frontend's Google Identity Services button produces (see
# GOOGLE_CLIENT_ID / verifyIdToken in auth.service.ts). Must match
# NEXT_PUBLIC_GOOGLE_CLIENT_ID on the frontend - they're the same Client ID,
# just read on each side. Leave unset to keep "Sign in with Google"
# disabled (the endpoint returns a 500 rather than silently no-op'ing).
GOOGLE_CLIENT_ID=
