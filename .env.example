POSTGRES_DB=adnetwork
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

REDIS_PORT=6379

CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

CORS_ORIGIN=http://localhost:3000

# Fraud/bot detection (ad-engine) - see backend/src/ad-engine/fraud-detection.service.ts
# Signs the per-click integrity token (backend/src/ad-engine/click-integrity.service.ts).
# MUST be set to a long random value in production - the dev fallback is not secret.
CLICK_TOKEN_SECRET=change-me-to-a-random-value
# Block (not just log) a click from a known datacenter/hosting IP when it would
# actually be billed. Set to "false" to only flag such clicks for analytics.
BLOCK_DATACENTER_IP_CLICKS=true

# PayPal - advertiser wallet top-ups (backend/src/payments). Leave unset in
# dev/until you have real keys: order creation returns a 503 instead of the
# app failing to boot. Get these from developer.paypal.com > Apps & Credentials.
# "sandbox" (default) hits api-m.sandbox.paypal.com; set to "live" once using
# real production credentials.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Dashboard > Apps & Credentials > (your app) > Webhooks > (your webhook) >
# Webhook ID. MUST be set for the webhook to accept anything - see
# PayPalService.verifyWebhookSignature.
PAYPAL_WEBHOOK_ID=

# Razorpay - the other advertiser wallet top-up option, alongside PayPal
# above (backend/src/payments). Leave unset in dev/until you have real keys:
# order creation returns a 503 instead of the app failing to boot. Get these
# from dashboard.razorpay.com > Settings > API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks > (your webhook) > Secret. MUST be set for
# the webhook to accept anything - see RazorpayService.verifyWebhookSignature.
RAZORPAY_WEBHOOK_SECRET=
# Admin-editable via PATCH /api/v1/admin/settings/usd-to-inr-rate - this is
# only the fallback used until an admin sets one. Used to price an
# INR-currency Razorpay order from the wallet's fixed USD credit amount.
USD_TO_INR_RATE=90

# RazorpayX - publisher payouts (backend/src/wallet/payout-providers). A
# separate product/account from Razorpay Payments above, requiring its own
# KYC-approved RazorpayX current account. Leave all three unset to keep
# payouts on the manual queue (an admin confirms bank transfers by hand).
# Get these from dashboard.razorpay.com > RazorpayX > (your account) > API
# Keys, and the account number from the RazorpayX current account itself.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
# Dashboard > Account & Settings > Webhooks (RazorpayX has its own, separate
# from the Razorpay Payments webhook above) > Secret.
RAZORPAYX_WEBHOOK_SECRET=
