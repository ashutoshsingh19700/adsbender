POSTGRES_DB=adnetwork
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

REDIS_PORT=6379

CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

CORS_ORIGIN=http://localhost:3000

# Fraud/bot detection (ad-engine) - see backend/src/ad-engine/fraud-detection.service.ts
# Signs the per-click integrity token (backend/src/ad-engine/click-integrity.service.ts).
# MUST be set to a long random value in production - the dev fallback is not secret.
CLICK_TOKEN_SECRET=change-me-to-a-random-value
# Block (not just log) a click from a known datacenter/hosting IP when it would
# actually be billed. Set to "false" to only flag such clicks for analytics.
BLOCK_DATACENTER_IP_CLICKS=true

# Razorpay - advertiser wallet top-ups (backend/src/payments). Leave unset in
# dev/until you have real keys: order creation returns a 503 instead of the
# app failing to boot. Get these from Razorpay Dashboard > Settings > API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks > (your webhook) > Secret. MUST be set for
# the webhook to accept anything - see PaymentsController.handleWebhook.
RAZORPAY_WEBHOOK_SECRET=
# Fallback USD->INR rate used to price an INR top-up when no admin override
# exists in PlatformSetting.usdToInrRate (PATCH /api/v1/admin/settings/usd-to-inr-rate).
USD_TO_INR_RATE=90
