POSTGRES_DB=adnetwork
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

REDIS_PORT=6379

CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

CORS_ORIGIN=http://localhost:3000

# Fraud/bot detection (ad-engine) - see backend/src/ad-engine/fraud-detection.service.ts
# Signs the per-click integrity token (backend/src/ad-engine/click-integrity.service.ts).
# MUST be set to a long random value in production - the dev fallback is not secret.
CLICK_TOKEN_SECRET=change-me-to-a-random-value
# Block (not just log) a click from a known datacenter/hosting IP when it would
# actually be billed. Set to "false" to only flag such clicks for analytics.
BLOCK_DATACENTER_IP_CLICKS=true

# PayPal - advertiser wallet top-ups (backend/src/payments). Leave unset in
# dev/until you have real keys: order creation returns a 503 instead of the
# app failing to boot. Get these from developer.paypal.com > Apps & Credentials.
# "sandbox" (default) hits api-m.sandbox.paypal.com; set to "live" once using
# real production credentials.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Dashboard > Apps & Credentials > (your app) > Webhooks > (your webhook) >
# Webhook ID. MUST be set for the webhook to accept anything - see
# PayPalService.verifyWebhookSignature.
PAYPAL_WEBHOOK_ID=
